# Supabase Connect > Session pooler (or direct connection). Backend only.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Publishable key (or legacy anon key). No service-role/admin key is needed.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000
REMEMBER_DAYS=30
